  "item": [
    {
      "name": "Agences",
      "item": [
        {
          "name": "Liste",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{asiApiUrl}}/agences",
              "host": ["{{asiApiUrl}}"],
              "path": ["agences"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Réponse JSON non cyclique\", function () {",
                  "    pm.response.to.be.json;",
                  "    pm.expect(pm.response.json()).to.be.an(\"array\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultation-existant",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{asiApiUrl}}/agences/{{agenceId}}",
              "host": ["{{asiApiUrl}}"],
              "path": ["agences", "{{agenceId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Identifiant retourné\", function () {",
                  "    pm.expect(pm.response.json().idAgence).to.eql(Number(pm.collectionVariables.get(\"agenceId\")));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultation-inexistant",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{asiApiUrl}}/agences/9999",
              "host": ["{{asiApiUrl}}"],
              "path": ["agences", "9999"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 404\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "pm.test(\"Corps d'erreur JSON\", function () {",
                  "    pm.expect(pm.response.json().status).to.eql(404);",
                  "    pm.expect(pm.response.json().error).to.eql(\"Not Found\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Ajout-sans-id",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Agence Marsa\",\n  \"ville\": \"La Marsa\",\n  \"adresse\": \"12 Avenue Habib Bourguiba\",\n  \"telephone\": \"71777777\"\n}"
            },
            "url": {
              "raw": "{{asiApiUrl}}/agences",
              "host": ["{{asiApiUrl}}"],
              "path": ["agences"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Identifiant généré\", function () {",
                  "    const agence = pm.response.json();",
                  "    pm.expect(agence.idAgence).to.be.a(\"number\");",
                  "    pm.collectionVariables.set(\"agenceId\", agence.idAgence);",
                  "});"
                ]
              }
            }
